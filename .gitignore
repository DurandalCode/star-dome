# Generated geometry / exports
exports/*
!exports/.gitkeep
*.stl
*.3mf
*.obj
*.ply
*.gltf
*.glb

# Blender autosaves / backups
*.blend1
*.blend2
*.blend@

# FreeCAD. The .FCStd files under connectors/ are generated by the scripts in
# that directory -- 'make clamps' rewrites them -- so they are output, not
# source. The scripts and docs/ are the source.
*.FCStd1
*.FCBak
connectors/*.FCStd

# Render outputs
renders/
exports/shots/
*.exr

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/

# Local agent/tool state
.claude/settings.local.json
.env
.env.*
